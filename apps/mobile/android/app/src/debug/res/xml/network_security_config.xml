<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds only — this file lives under src/debug, so it is not merged
    into a release APK and release traffic stays https-only.

    Android has blocked cleartext HTTP by default since API 28. Two of the three
    hosts in src/config.js are plain http (the Local one, and Development at
    dev.api.busycarrot.com), so without this a debug build pointed at either
    fails every request with ERR_CLEARTEXT_NOT_PERMITTED and nothing in the UI
    explains why.

    10.0.2.2 is how the Android emulator reaches the host machine's localhost.
    To run against an API on your LAN, add that machine's IP as another
    <domain> below.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="true">dev.api.busycarrot.com</domain>
        <domain includeSubdomains="false">195.216.213.73</domain>
    </domain-config>
</network-security-config>
