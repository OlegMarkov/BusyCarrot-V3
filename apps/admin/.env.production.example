# Copy to .env.production and build: `npm run build:admin`.
#
# Vite inlines every VITE_* value into the bundle at build time, so this file
# decides which environment the artifact belongs to. A build is not promotable
# between environments — build once per target.
#
# None of these are secrets. The Auth0 client id and the API URL both ship in
# the JavaScript by design; the client *secret* is server-side only and appears
# nowhere in this repo.

# Vegetable.API root. Trailing slash required — the client joins paths onto it.
VITE_API_BASE_URL=https://api.busycarrot.com/

# The public booking site. Used to build an owner's shareable link.
VITE_OBS_BASE_URL=https://busycarrot.com/

# This app's own origin. Auth0 returns here after logout, and it builds the
# staff invite link, so it must match the deployed host exactly.
VITE_ADMIN_BASE_URL=https://admin.busycarrot.com/

# Auth0. Add the deployed origin to Allowed Web Origins, Allowed Callback URLs
# and Allowed Logout URLs in the Auth0 dashboard, or login fails at the tenant
# rather than in the app.
VITE_AUTH0_CLIENT_ID=KpF5kduqFqXVHykbcCDDMYhUI0VPboP3
VITE_AUTH0_DOMAIN=vegetableproj.eu.auth0.com
VITE_OWNER_ID_FIELD=https://vegetable.com/company_id

# Development only, and guarded by import.meta.env.DEV as well, so it is
# compiled out of a production build whatever it is set to. Left here so the
# variable is not a surprise.
VITE_DEV_BYPASS_AUTH=false
