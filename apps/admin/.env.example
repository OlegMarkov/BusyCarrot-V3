# Vegetable.API root. Trailing slash required — the client joins paths onto it.
VITE_API_BASE_URL=http://localhost:5000/

# The public booking site. Used to show an owner their own URL.
VITE_OBS_BASE_URL=https://busycarrot.com/

# ---------------------------------------------------------------------------
# There is no Auth0 configuration here any more.
# ---------------------------------------------------------------------------
# Admin signs in the same way the mobile app does: phone number, a verification
# call, then `POST users/authenticate`, which returns the API's own bearer token.
# That is the only credential `[AuthorizeOwner]` accepts — `JwtMiddleware`
# validates HS256 against the API's `Secret` and reads `id` and `userId` claims,
# neither of which an Auth0 token carries.
#
# Nothing here is secret. Both values ship in the JavaScript by design.
#
# Running against a local API: appsettings.Local.json sets
# `AllowTestVerificationCode`, so any number containing 123456 accepts the code
# 123456 and no call is placed. The image captcha is still checked — read it off
# the login screen like a user would.
