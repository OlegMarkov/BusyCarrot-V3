VITE_OBS_BASE_URL=https://busycarrot.com/
VITE_ADMIN_BASE_URL=http://localhost:5173/
VITE_AUTH0_CLIENT_ID=KpF5kduqFqXVHykbcCDDMYhUI0VPboP3
VITE_AUTH0_DOMAIN=vegetableproj.eu.auth0.com
VITE_OWNER_ID_FIELD=https://vegetable.com/company_id

# Development only. Skips the Auth0 login so the app can be run without a live
# tenant — Auth0's checkSession hangs rather than failing when it cannot reach
# one, which otherwise leaves the app on an empty shell.
#
# It is guarded by import.meta.env.DEV as well as this flag, so it is compiled
# out of production builds entirely rather than being a runtime switch. Requests
# then carry no bearer token, so point VITE_API_BASE_URL at an API that permits
# that. See src/plugins/dev-auth.js.
VITE_DEV_BYPASS_AUTH=false
