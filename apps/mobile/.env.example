# Local development only. Copy to `.env.development.local`, which Vite loads
# for `vite dev` and nothing else, so it cannot be baked into a build.
#
# Overrides the `Local` API host in src/config.js. `npm run mock:api` from the
# repo root serves the owner surface, the captcha and the login routes on 5098.
VITE_API_BASE_URL=http://localhost:5098/

# Not set here on purpose.
#
# VITE_APP_ENV picks which host set src/config.js resolves — Local,
# Development or Production — and it is what a Capacitor build bakes in.
# tools/capacitor-sync.mjs passes it on the command line:
#
#     node tools/capacitor-sync.mjs --env Production
#
# Putting it in a file would mean a release could inherit whatever a developer
# happened to leave on disk. Leave it out.
