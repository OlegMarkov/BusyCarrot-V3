# H5 (`npm run dev:mobile`) only — the packaged app reads src/config.js instead,
# which selects its host by `Env` and uni-app conditional compilation.
#
# Point this at whatever API is running locally. `npm run mock:api` from the repo
# root serves the owner surface, the captcha and the login routes on 5098.
#
# Copy to .env.development.local (loaded by `vite dev` only, so it cannot be
# baked into a build) rather than .env.local.
VITE_API_BASE_URL=http://localhost:5098/
