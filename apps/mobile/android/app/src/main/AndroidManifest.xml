<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
            Without these, Firebase falls back to the launcher icon, which
            Android renders as a silhouette — a full-colour icon comes out as a
            featureless white square. ic_stat_notify is a flat white shape for
            exactly that reason; do not replace it with a coloured one.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Contact import (pages/customer/contactImportList.vue). The
        @capacitor-community/contacts plugin requests these at runtime but does
        not declare them, so they have to be here or requestPermissions() is
        refused outright. WRITE is in the plugin's permission alias alongside
        READ; the app only ever reads.
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />

    <!--
        Android 13+ gates notifications behind a runtime prompt. Without this
        declared, PushNotifications.requestPermissions() returns denied without
        ever showing the dialog, so the device never registers with FCM.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
