# Vegetable.API root. Every Obs call is anonymous (no bearer token).
VITE_API_BASE_URL=http://localhost:5000/

# Google reCAPTCHA v3 site key.
#
# Required to book. Vegetable.API guards PUT publicowner/reservation/{alias} and
# GET publicowner/verifycode/{phone} with QueryTokenFilter, which verifies a
# reCAPTCHA token passed as ?token= and returns 401 without one. Leave this
# unset for local UI work — the wizard runs up to the point of booking and then
# says captcha is not configured, rather than sending a request that would 401.
VITE_RECAPTCHA_SITE_KEY=

# Yandex Maps JS API key. Optional — when unset, the "show on map" link on the
# owner page is hidden and the maps script is never loaded.
VITE_YANDEX_MAPS_KEY=
