# Copy to .env.production and build: `npm run build:obs`.
#
# Vite inlines every VITE_* value at build time, so this file decides which
# environment the artifact belongs to. Build once per target.

# Vegetable.API root. Every Obs call is anonymous — no bearer token.
VITE_API_BASE_URL=https://api.busycarrot.com/

# Google reCAPTCHA v3 site key.
#
# Booking does not work without it. Vegetable.API guards
# PUT publicowner/reservation/{alias} and GET publicowner/verifycode/{phone}
# with QueryTokenFilter, which verifies a reCAPTCHA token passed as ?token= and
# returns 401 when there is none. With this unset the wizard runs right up to
# the point of booking and then says captcha is not configured — which is the
# honest failure, but it is still a site that cannot take a booking.
#
# The site key is public by design; the *secret* key belongs to the API.
VITE_RECAPTCHA_SITE_KEY=

# Yandex Maps JS API key. Optional — with it unset the "show on map" link on an
# owner's page is hidden and the maps script is never loaded.
VITE_YANDEX_MAPS_KEY=
